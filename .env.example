# Startup defaults. Settings saved in the UI override these values.
PORT=3000
LLM_PROVIDER=demo
# For Ollama: LLM_PROVIDER=ollama and base URL http://127.0.0.1:11434
# For hosted APIs: LLM_PROVIDER=openai-compatible
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=
LLM_API_KEY=
LLM_MAX_OUTPUT_TOKENS=4096
LLM_TOKEN_PARAMETER=max_completion_tokens
# Use max_tokens if your compatible provider requires it.
# Legacy OLLAMA_MODEL / OLLAMA_URL work when LLM_PROVIDER is unset.
